  m_Script: {fileID: 11500000, guid: 9022c7a62da884cbd95368c39c76e4dd, type: 3}
  m_Name: Monologue_BurnoutIndicator
  m_EditorClassIdentifier: Assembly-CSharp::MonologueDefinition
  id: Burnout_Indicator
  speaker: Mare
  portrait: {fileID: 0}
  lines:
  - text: What the hell is that?
    speaker: 
    portrait: {fileID: 0}
    clip: {fileID: 0}
    sound:
      value: WhatTheHell
    charactersPerSecond: 0
    holdDuration: 0
  - text: Were they messing with my computer again?
    speaker: 
    portrait: {fileID: 0}
    clip: {fileID: 0}
    sound:
      value: WereThey
    charactersPerSecond: 0
    holdDuration: 0
  - text: Ah, this must be the burnout indicator HR mentioned.
    speaker: 
    portrait: {fileID: 0}
    clip: {fileID: 0}
    sound:
      value: ThatMustBe
    charactersPerSecond: 0
    holdDuration: 0
  - text: Apparently, burnout is a serious concern around here.
    speaker: 
    portrait: {fileID: 0}
    clip: {fileID: 0}
    sound:
      value: Apparently
    charactersPerSecond: 0
    holdDuration: 0
  - text: So serious, that management has introduced a company-wide wellness initiative.
    speaker: 
    portrait: {fileID: 0}
    clip: {fileID: 0}
    sound:
      value: SoSerious
    charactersPerSecond: 0
    holdDuration: 0
  - text: "With all the work I already do, I have to do some smalls tasks that should
      help \u201Creduce burnout\u201D."
    speaker: 
    portrait: {fileID: 0}
    clip: {fileID: 0}
    sound:
      value: WithAllTheWork
    charactersPerSecond: 0
    holdDuration: 0
  - text: Some choices should increase the burnout level making me feel more exhausted
      and stressed, other choices should help me feel more calm.
    speaker: 
    portrait: {fileID: 0}
    clip: {fileID: 0}
    sound:
      value: SomeChoices
    charactersPerSecond: 0
    holdDuration: 0
  - text: "As if I don\u2019t have enough work without all that crap."
    speaker: 
    portrait: {fileID: 0}
    clip: {fileID: 0}
    sound:
      value: AsIfIDontHave
    charactersPerSecond: 0
    holdDuration: 0
  - text: "Well, the deadlines won\u2019t meet themselves. What\u2019s first on my
      list\u2026"
    speaker: 
    portrait: {fileID: 0}
    clip: {fileID: 0}
    sound:
      value: WellTheDeadlines
    charactersPerSecond: 0
    holdDuration: 0
  charactersPerSecond: 0
